rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // FACTURAS INDEPENDIENTES
    // ==========================================
    match /users/{userId}/invoices/{invoiceId}/{fileName} {

      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }


    // ==========================================
    // FACTURAS DENTRO DE VIAJES
    // ==========================================
    match /users/{userId}/travels/{travelId}/invoices/{fileName} {

      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }


    // ==========================================
    // BLOQUEAR TODO LO DEMÁS
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}